{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@pointing-poker/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*"]
}
